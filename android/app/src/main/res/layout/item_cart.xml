<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="4dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:strokeColor="#EAEEEC"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:id="@+id/ivCartProductImage"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:background="#F8FAF9"
            android:contentDescription="Ảnh"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCartProductName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCartProductPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_price"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Quantity Counter -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_search_bar"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnCartMinus"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@null"
                    android:contentDescription="Giảm"
                    android:padding="4dp"
                    android:src="@drawable/ic_minus"
                    app:tint="@color/text_primary" />

                <TextView
                    android:id="@+id/tvCartQuantity"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnCartPlus"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@null"
                    android:contentDescription="Tăng"
                    android:padding="4dp"
                    android:src="@drawable/ic_add"
                    app:tint="@color/text_primary" />
            </LinearLayout>
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnCartDelete"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@null"
            android:contentDescription="Xóa"
            android:src="@drawable/ic_back"
            android:rotation="45"
            app:tint="@color/text_hint" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
